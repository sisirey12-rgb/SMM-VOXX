NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@vox.local
ADMIN_PASSWORD=change-this-before-deploying
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=vox_smm
MYSQL_USER=vox_user
MYSQL_PASSWORD=change-me
PROVIDER_MODE=mock
PROVIDER_NAME=ezkify
EZKIFY_BASE_URL=https://ezkify.com/api/v2
EZKIFY_API_KEY=
# Add only service IDs you have reviewed and are authorized to resell. Empty means no live orders.
EZKIFY_ALLOWED_SERVICE_IDS=
ORGANIC_SMM_BASE_URL=https://organicsmm.online/functions/v1/public-api
ORGANIC_SMM_API_KEY=
# Read-only catalog visibility allowlist; OrganicSMM order placement is disabled in VOX.
ORGANIC_SMM_ALLOWED_SERVICE_IDS=
